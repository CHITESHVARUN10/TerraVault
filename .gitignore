# ------------------------------------------------------------------
# TerraVault — root .gitignore
# ------------------------------------------------------------------

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Command Code (local agent config — not a project contributor)
.commandcode/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db

# Testing / coverage
coverage/
*.lcov

# Caches
.cache/
.eslintcache
.turbo/

# Misc
*.local
*.sw?
tmp/
temp/
