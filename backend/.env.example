# Server
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/terravault
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_STORE=memory
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Google Drive integration (see https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/drive/oauth-callback
# Encryption key for OAuth tokens at rest — at least 32 characters
DRIVE_TOKEN_KEY=change-me-to-a-long-random-string-at-least-32-chars
